    "raw_hex": "52 6f 6e 20 48 61 72 72 69 73 0a 0a 52 6f 62 65 72 74 20 43 6c 61 72 64 79 0a 0a 41 6c 61 6e 20 42 2e 20 43 6c 61 72 6b 0a 52 6f 62 65 72 74 20 43 6c 61 72 64 79 0a 0a 41 6c 61 6e 20 42 2e 20 43 6c 61 72 6b 0a 0a 47 72 61 65 6d 65 20 44 65 76 69 6e 65 0a 0a 4d 69 6b 65 20 42 72 61 6e 68 61 6d 0a 4c 6c 6f 79 64 20 4f 6c 6c 6d 61 6e 6e 2c 20 4a 72 2e 0a 4a 6f 68 6e 20 43 6f 6e 6c 65 79 0a 4a 69 6d 20 4d 63 42 72 69 64 65 0a 4d 69 63 68 61 65 6c 20 50 61 72 6b 0a 0a 44 61 76 69 64 20 53 63 68 72 6f 65 64 65 72 0a 4d 69 63 68 61 65 6c 20 4f 72 6d 73 62 79 0a 4d 69 6b 65 20 43 68 72 69 73 74 79 0a 0a 44 61 76 69 64 20 53 63 68 72 6f 65 64 65 72 0a 0a 41 6e 6e 20 44 69 63 6b 65 6e 73 20 43 6c 61 72 64 79 0a 4d 69 63 68 61 65 6c 20 4f 72 6d 73 62 79 0a 4d 61 72 63 75 73 20 53 74 72 65 65 74 73 0a 47 72 61 65 6d 65 20 44 65 76 69 6e 65 0a 0a 4d 61 72 63 75 73 20 53 74 72 65 65 74 73 0a 0a 4d 61 72 6b 20 52 69 6c 65 79 0a 0a 4d 69 6b 65 20 53 69 6e 67 6c 65 74 6f 6e 00",
    "source_file": "AText.res",
    "source_member": "WarInMiddleEarth/data/Disk.1",
    "text": "Ron Harris\n\nRobert Clardy\n\nAlan B. Clark\nRobert Clardy\n\nAlan B. Clark\n\nGraeme Devine\n\nMike Branham\nLloyd Ollmann, Jr.\nJohn Conley\nJim McBride\nMichael Park\n\nDavid Schroeder\nMichael Ormsby\nMike Christy\n\nDavid Schroeder\n\nAnn Dickens Clardy\nMichael Ormsby\nMarcus Streets\nGraeme Devine\n\nMarcus Streets\n\nMark Riley\n\nMike Singleton",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 0,
    "length": 46,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "2c 20 74 68 69 73 20 69 73 20 77 65 6c 6c 20 6d 65 74 21 20 49 20 68 61 76 65 20 68 65 61 72 64 20 61 6e 20 6f 64 64 20 74 61 6c 65 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": ", this is well met! I have heard an odd tale.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 1,
    "length": 46,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "21 20 49 20 77 61 73 20 73 65 65 6b 69 6e 67 20 79 6f 75 2e 20 49 20 68 61 76 65 20 69 6e 74 65 72 65 73 74 69 6e 67 20 6e 65 77 73 21 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "! I was seeking you. I have interesting news!",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 2,
    "length": 49,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "21 20 57 65 20 6d 65 65 74 20 61 67 61 69 6e 2e 20 49 20 68 61 76 65 20 6f 6d 69 6e 6f 75 73 20 74 69 64 69 6e 67 73 20 66 6f 72 20 79 6f 75 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "! We meet again. I have ominous tidings for you.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 3,
    "length": 45,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "2c 20 77 68 61 74 20 61 20 66 6f 72 74 75 69 74 6f 75 73 20 6d 65 65 74 69 6e 67 21 20 4c 69 73 74 65 6e 20 63 6c 6f 73 65 6c 79 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": ", what a fortuitous meeting! Listen closely.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 4,
    "length": 36,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 20 6d 75 73 74 20 67 6f 20 6e 6f 77 2c 20 62 75 74 20 6f 6e 65 20 6c 61 73 74 20 74 68 69 6e 67 3a 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "I must go now, but one last thing: ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 5,
    "length": 42,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "57 65 6c 6c 2c 20 49 20 6d 75 73 74 20 74 61 6b 65 20 6d 79 20 6c 65 61 76 65 2c 20 62 75 74 20 72 65 6d 65 6d 62 65 72 3a 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Well, I must take my leave, but remember:",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 6,
    "length": 48,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "47 6f 20 6e 6f 77 20 77 69 74 68 20 61 20 67 6f 6f 64 20 68 65 61 72 74 21 20 54 68 69 73 20 69 73 20 6d 79 20 6c 61 73 74 20 77 6f 72 64 3a 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Go now with a good heart! This is my last word:",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 7,
    "length": 45,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 69 6d 65 20 69 73 20 73 68 6f 72 74 2e 20 42 75 74 20 69 6e 20 70 61 72 74 69 6e 67 20 74 68 69 6e 6b 20 6f 6e 20 74 68 69 73 3a 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Time is short. But in parting think on this:",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 8,
    "length": 91,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 6f 20 74 68 65 20 4e 6f 72 74 68 20 6f 66 20 74 68 65 20 57 68 69 74 65 20 54 6f 77 65 72 73 20 65 78 69 73 74 73 20 61 20 72 61 76 69 6e 65 20 77 68 65 72 65 69 6e 0a 6d 61 79 20 62 65 20 66 6f 75 6e 64 20 61 20 68 65 61 6c 69 6e 67 20 64 72 61 75 67 68 74 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "To the North of the White Towers exists a ravine wherein\nmay be found a healing draught.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 9,
    "length": 79,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "57 65 73 74 20 6f 66 20 74 68 65 20 6f 6e 63 65 20 70 72 6f 75 64 20 63 69 74 79 20 6f 66 20 41 6e 6e 75 6d 69 6e 61 73 20 61 20 67 6f 6c 64 65 6e 20 53 63 65 70 74 72 65 0a 68 61 73 20 77 61 73 68 65 64 20 61 73 68 6f 72 65 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "West of the once proud city of Annuminas a golden Sceptre\nhas washed ashore.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 10,
    "length": 141,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 66 6f 72 6d 65 72 20 74 69 6d 65 73 2c 20 61 20 62 61 6e 64 20 6f 66 20 44 77 61 72 76 65 73 20 6a 6f 75 72 6e 65 79 69 6e 67 20 6e 6f 72 74 68 20 6f 66 0a 45 72 65 62 6f 72 20 77 65 72 65 20 73 6c 61 69 6e 20 62 79 20 47 6f 62 6c 69 6e 73 2e 20 54 68 65 72 65 2c 20 61 20 67 72 65 61 74 20 68 61 6d 6d 65 72 2c 20 61 20 67 69 66 74 0a 6f 66 20 74 68 65 20 65 6c 76 65 73 2c 20 77 61 73 20 6c 6f 73 74 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In former times, a band of Dwarves journeying north of\nErebor were slain by Goblins. There, a great hammer, a gift\nof the elves, was lost.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 11,
    "length": 88,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "53 6f 75 74 68 20 6f 66 20 4d 6f 75 6e 74 20 47 72 61 6d 2c 20 61 20 62 61 6e 64 20 6f 66 20 4f 72 63 73 20 62 65 69 6e 67 20 70 75 72 73 75 65 64 20 62 79 0a 52 61 6e 67 65 72 73 20 63 61 73 74 20 61 73 69 64 65 20 74 68 65 69 72 20 73 70 6f 69 6c 73 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "South of Mount Gram, a band of Orcs being pursued by\nRangers cast aside their spoils.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 12,
    "length": 107,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 74 68 65 20 45 72 65 64 20 4d 69 74 68 72 69 6e 20 6d 61 79 20 62 65 20 66 6f 75 6e 64 20 67 72 65 61 74 20 74 72 65 61 73 75 72 65 2c 20 61 6e 64 0a 65 76 65 6e 20 67 72 65 61 74 65 72 20 64 61 6e 67 65 72 2e 20 42 65 77 61 72 65 20 74 68 65 20 73 65 72 76 61 6e 74 73 20 6f 66 20 4d 65 6c 6b 6f 72 21 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In the Ered Mithrin may be found great treasure, and\neven greater danger. Beware the servants of Melkor!  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 13,
    "length": 126,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "55 6e 6b 6e 6f 77 6e 20 74 6f 20 54 68 72 61 69 6e 27 73 20 63 61 70 74 6f 72 73 2c 20 68 65 20 68 69 64 20 68 69 73 20 52 69 6e 67 20 69 6e 20 61 20 67 6c 61 64 65 0a 6e 6f 72 74 68 20 6f 66 20 74 68 65 20 4e 65 63 72 6f 6d 61 6e 63 65 72 27 73 20 54 6f 77 65 72 20 61 73 20 68 65 20 77 61 73 20 62 65 69 6e 67 20 74 61 6b 65 6e 20 74 6f 0a 68 69 73 20 64 6f 6f 6d 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Unknown to Thrain's captors, he hid his Ring in a glade\nnorth of the Necromancer's Tower as he was being taken to\nhis doom.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 14,
    "length": 63,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "41 72 76 65 64 75 69 27 73 20 63 72 79 73 74 61 6c 20 73 70 68 65 72 65 20 68 61 73 20 77 61 73 68 65 64 20 61 73 68 6f 72 65 20 73 6f 75 74 68 20 6f 66 0a 46 6f 72 6c 6f 6e 64 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Arvedui's crystal sphere has washed ashore south of\nForlond.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 15,
    "length": 102,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 77 61 74 65 72 73 20 6f 66 20 74 68 65 20 47 6c 61 6e 64 75 69 6e 20 77 61 73 68 20 67 6c 69 74 74 65 72 69 6e 67 20 45 6c 66 2d 77 72 6f 75 67 68 74 0a 73 68 61 72 64 73 20 73 6f 75 74 68 20 66 72 6f 6d 20 74 68 65 20 72 75 69 6e 73 20 6f 66 20 4f 73 74 2d 69 6e 2d 45 64 68 69 6c 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The waters of the Glanduin wash glittering Elf-wrought\nshards south from the ruins of Ost-in-Edhil.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 16,
    "length": 91,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 74 68 65 20 4f 6c 64 20 46 6f 72 65 73 74 20 65 61 73 74 20 6f 66 20 42 75 63 6b 6c 61 6e 64 20 69 73 20 61 20 73 74 61 6e 64 20 6f 66 20 74 72 65 65 73 0a 77 68 6f 73 65 20 77 6f 6f 64 20 69 73 20 70 72 69 7a 65 64 20 62 79 20 74 68 65 20 77 69 73 65 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In the Old Forest east of Buckland is a stand of trees\nwhose wood is prized by the wise.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 17,
    "length": 140,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "57 68 65 72 65 20 74 68 65 20 4c 61 6e 67 77 65 6c 6c 20 66 6c 6f 77 73 20 66 72 6f 6d 20 4d 6f 75 6e 74 20 47 75 6e 64 61 62 61 64 20 69 74 20 68 61 73 0a 74 61 6b 65 6e 20 65 61 73 74 20 77 69 74 68 20 69 74 20 61 6e 20 61 6e 63 69 65 6e 74 20 74 72 65 61 73 75 72 65 20 73 74 6f 6c 65 6e 20 66 72 6f 6d 20 74 68 65 0a 45 6c 76 65 73 20 62 79 20 4f 72 63 73 20 69 6e 20 61 20 66 6f 72 6d 65 72 20 61 67 65 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Where the Langwell flows from Mount Gundabad it has\ntaken east with it an ancient treasure stolen from the\nElves by Orcs in a former age.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 18,
    "length": 139,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "42 65 74 77 65 65 6e 20 74 68 65 20 6d 6f 75 74 68 73 20 6f 66 20 74 68 65 20 47 77 61 74 68 6c 6f 20 61 6e 64 20 49 73 65 6e 20 6c 69 76 65 20 61 0a 72 61 63 65 20 6f 66 20 70 65 6f 70 6c 65 20 77 68 6f 2c 20 73 69 6e 63 65 20 65 6c 64 65 72 20 74 69 6d 65 73 2c 20 68 61 76 65 20 62 72 65 77 65 64 20 70 6f 74 69 6f 6e 73 0a 77 69 74 68 20 70 6f 74 65 6e 74 20 68 65 61 6c 69 6e 67 20 70 6f 77 65 72 73 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Between the mouths of the Gwathlo and Isen live a\nrace of people who, since elder times, have brewed potions\nwith potent healing powers.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 19,
    "length": 62,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 47 72 65 79 20 48 61 76 65 6e 73 20 6d 61 79 20 62 65 20 66 6f 75 6e 64 20 68 65 61 6c 69 6e 67 20 66 6f 72 20 62 6f 74 68 20 62 6f 64 79 0a 61 6e 64 20 73 6f 75 6c 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In Grey Havens may be found healing for both body\nand soul.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 20,
    "length": 129,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "4e 6f 20 73 74 6f 75 74 65 72 20 61 20 62 72 65 77 20 6d 61 79 20 62 65 20 66 6f 75 6e 64 20 74 68 61 6e 20 74 68 65 20 42 6c 61 63 6b 20 46 6c 61 73 6b 20 41 6c 65 0a 6f 66 20 54 75 63 6b 62 6f 72 6f 75 67 68 21 20 41 20 6c 6f 6e 67 20 64 72 61 75 67 68 74 20 77 69 6c 6c 20 6d 61 6b 65 20 61 20 6e 65 77 20 6d 61 6e 2c 0a 6f 72 20 68 6f 62 62 69 74 2c 20 6f 66 20 79 6f 75 21 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "No stouter a brew may be found than the Black Flask Ale\nof Tuckborough! A long draught will make a new man,\nor hobbit, of you!  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 21,
    "length": 98,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 72 65 20 6c 69 76 65 73 20 61 6e 20 6f 6c 64 20 48 65 72 62 61 6c 69 73 74 20 69 6e 20 4d 69 63 68 65 6c 20 44 65 6c 76 69 6e 67 20 77 68 6f 0a 63 6f 6d 70 6f 75 6e 64 73 20 61 20 6d 6f 73 74 20 70 6f 74 65 6e 74 20 68 65 61 6c 69 6e 67 20 70 72 65 70 61 72 61 74 69 6f 6e 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "There lives an old Herbalist in Michel Delving who\ncompounds a most potent healing preparation.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 22,
    "length": 124,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 74 68 65 20 72 75 69 6e 73 20 6f 66 20 61 6e 63 69 65 6e 74 20 42 65 6c 65 67 6f 73 74 2c 20 6f 6e 63 65 20 74 68 65 20 70 72 6f 75 64 65 73 74 20 6f 66 0a 44 77 61 72 76 65 6e 20 66 6f 72 74 72 65 73 73 65 73 2c 20 73 74 6f 75 74 20 68 65 61 72 74 73 20 6d 61 79 20 73 74 69 6c 6c 20 66 69 6e 64 20 65 6c 64 72 69 63 68 0a 74 72 65 61 73 75 72 65 73 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In the ruins of ancient Belegost, once the proudest of\nDwarven fortresses, stout hearts may still find eldrich\ntreasures.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 23,
    "length": 140,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "4c 6f 6e 67 20 61 6e 64 20 66 61 69 74 68 66 75 6c 20 77 6f 75 6c 64 20 74 68 65 20 66 72 69 65 6e 64 73 68 69 70 20 6f 66 20 74 68 65 20 44 77 61 72 76 65 73 0a 6f 66 20 44 75 72 69 6e 27 73 20 6c 69 6e 65 20 62 65 20 74 6f 20 61 6e 79 6f 6e 65 20 77 68 6f 20 63 6f 75 6c 64 20 72 65 74 75 72 6e 20 74 6f 20 74 68 65 6d 0a 74 68 65 69 72 20 6d 6f 73 74 20 70 72 65 63 69 6f 75 73 20 68 65 69 72 6c 6f 6f 6d 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Long and faithful would the friendship of the Dwarves\nof Durin's line be to anyone who could return to them\ntheir most precious heirloom.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 24,
    "length": 135,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 52 65 64 20 41 72 72 6f 77 20 69 73 20 74 68 65 20 73 79 6d 62 6f 6c 20 6f 66 20 6f 61 74 68 73 20 74 61 6b 65 6e 20 61 6e 64 20 72 65 63 65 69 76 65 64 0a 62 65 74 77 65 65 6e 20 74 68 65 20 4c 6f 72 64 20 6f 66 20 74 68 65 20 4d 61 72 6b 20 61 6e 64 20 74 68 65 20 53 74 65 77 61 72 64 20 6f 66 20 47 6f 6e 64 6f 72 0a 66 6f 72 20 6d 69 6c 69 74 61 72 79 20 73 75 70 70 6f 72 74 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Red Arrow is the symbol of oaths taken and received\nbetween the Lord of the Mark and the Steward of Gondor\nfor military support.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 25,
    "length": 161,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 53 63 65 70 74 72 65 20 77 61 73 20 74 68 65 20 63 68 69 65 66 20 6d 61 72 6b 20 6f 66 20 72 6f 79 61 6c 74 79 20 69 6e 20 4e 75 6d 65 6e 6f 72 2c 20 61 6e 64 0a 74 68 61 74 20 77 61 73 20 61 6c 73 6f 20 73 6f 20 69 6e 20 41 72 6e 6f 72 2e 20 48 65 20 77 68 6f 20 64 65 73 63 65 6e 64 73 20 64 69 72 65 63 74 6c 79 20 66 72 6f 6d 0a 49 73 69 6c 64 75 72 20 6d 61 79 20 61 6c 73 6f 20 63 6c 61 69 6d 20 74 68 65 20 63 72 6f 77 6e 20 6f 66 20 47 6f 6e 64 6f 72 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Sceptre was the chief mark of royalty in Numenor, and\nthat was also so in Arnor. He who descends directly from\nIsildur may also claim the crown of Gondor.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 26,
    "length": 132,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "49 6e 20 61 6e 63 69 65 6e 74 20 74 69 6d 65 73 20 61 20 70 72 6f 70 68 65 63 79 20 77 61 73 20 73 70 6f 6b 65 6e 20 77 68 69 63 68 20 73 61 69 64 20 73 79 6c 76 61 6e 0a 65 6c 76 65 73 20 77 6f 75 6c 64 20 66 6f 6c 6c 6f 77 20 74 68 65 20 62 65 61 72 65 72 20 6f 66 20 74 68 65 20 53 69 6c 76 65 72 20 4f 72 62 20 69 6e 74 6f 20 74 68 65 0a 66 69 6e 61 6c 20 63 6f 6e 66 6c 69 63 74 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "In ancient times a prophecy was spoken which said sylvan\nelves would follow the bearer of the Silver Orb into the\nfinal conflict.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 27,
    "length": 146,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 50 61 6c 61 6e 74 69 72 20 6d 61 79 20 67 69 76 65 20 6f 6e 65 20 73 65 63 6f 6e 64 20 73 69 67 68 74 2c 20 62 75 74 20 61 74 20 61 20 70 72 69 63 65 21 0a 42 65 77 61 72 65 2c 20 66 6f 72 20 74 68 65 20 44 61 72 6b 20 4f 6e 65 20 69 73 20 73 61 69 64 20 74 6f 20 68 6f 6c 64 20 61 6c 6c 20 74 68 65 20 73 65 65 69 6e 67 0a 63 72 79 73 74 61 6c 73 20 77 69 74 68 69 6e 20 68 69 73 20 66 65 6c 6c 20 70 6f 77 65 72 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Palantir may give one second sight, but at a price!\nBeware, for the Dark One is said to hold all the seeing\ncrystals within his fell power.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 28,
    "length": 57,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "46 61 69 74 68 6c 65 73 73 20 69 73 20 68 65 20 74 68 61 74 20 70 61 72 74 73 20 70 61 74 68 73 20 77 68 65 6e 20 74 68 65 20 72 6f 61 64 20 64 61 72 6b 65 6e 73 2e 0a 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Faithless is he that parts paths when the road darkens.\n",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 29,
    "length": 71,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "4c 65 74 20 68 69 6d 20 6e 6f 74 20 76 6f 77 20 74 6f 20 77 61 6c 6b 20 69 6e 20 74 68 65 20 64 61 72 6b 2c 20 77 68 6f 20 68 61 73 20 6e 6f 74 20 73 65 65 6e 0a 74 68 65 20 6e 69 67 68 74 66 61 6c 6c 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Let him not vow to walk in the dark, who has not seen\nthe nightfall.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 30,
    "length": 55,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "53 77 6f 72 6e 20 77 6f 72 64 20 6d 61 79 20 73 74 72 65 6e 67 74 68 65 6e 20 71 75 61 6b 69 6e 67 20 68 65 61 72 74 2c 20 6f 72 20 62 72 65 61 6b 20 69 74 2e 0a 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Sworn word may strengthen quaking heart, or break it.\n",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 31,
    "length": 68,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "4d 61 79 20 74 68 65 20 62 6c 65 73 73 69 6e 67 73 20 6f 66 20 45 6c 76 65 73 20 61 6e 64 20 4d 65 6e 20 61 6e 64 20 61 6c 6c 20 46 72 65 65 20 46 6f 6c 6b 0a 67 6f 20 77 69 74 68 20 79 6f 75 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "May the blessings of Elves and Men and all Free Folk\ngo with you.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 32,
    "length": 77,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "4c 6f 6f 6b 20 6e 6f 74 20 74 6f 6f 20 66 61 72 20 61 68 65 61 64 20 69 6e 20 79 6f 75 72 20 6a 6f 75 72 6e 65 79 21 20 4d 61 79 20 74 68 65 20 73 74 61 72 73 0a 73 68 69 6e 65 20 6f 6e 20 79 6f 75 72 20 66 61 63 65 73 2e 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Look not too far ahead in your journey! May the stars\nshine on your faces.  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 33,
    "length": 99,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "44 6f 6e 27 74 20 67 6f 20 6d 65 64 64 6c 69 6e 67 20 77 69 74 68 20 6f 6c 64 20 73 74 6f 6e 65 20 6f 72 20 63 6f 6c 64 20 57 69 67 68 74 73 20 75 6e 6c 65 73 73 0a 79 6f 75 20 68 61 76 65 20 73 74 72 6f 6e 67 20 68 65 61 72 74 73 20 74 68 61 74 20 6e 65 76 65 72 20 66 61 6c 74 65 72 21 20 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Don't go meddling with old stone or cold Wights unless\nyou have strong hearts that never falter!  ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 34,
    "length": 44,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "20 66 65 65 6c 73 20 61 6e 20 6f 64 64 20 73 74 72 65 6e 67 74 68 20 66 6c 6f 77 20 69 6e 74 6f 20 68 69 73 20 6c 69 6d 62 73 21 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": " feels an odd strength flow into his limbs!",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 35,
    "length": 46,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "20 68 61 73 20 61 20 67 72 6f 77 69 6e 67 20 66 65 65 6c 69 6e 67 20 6f 66 20 65 78 63 65 70 74 69 6f 6e 61 6c 20 68 65 61 6c 74 68 21 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": " has a growing feeling of exceptional health!",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 36,
    "length": 39,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 72 65 20 69 73 20 6e 6f 20 6e 65 65 64 20 74 6f 20 75 73 65 20 74 68 65 20 72 6f 70 65 20 68 65 72 65 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "There is no need to use the rope here.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 37,
    "length": 237,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "41 20 64 61 72 6b 20 73 6b 79 2c 20 74 61 6c 6c 20 62 61 74 74 6c 65 6d 65 6e 74 73 2c 20 61 6e 64 20 74 69 6e 79 20 73 74 61 72 73 2c 20 73 65 65 6d 69 6e 67 20 76 65 72 79 0a 66 61 72 20 61 77 61 79 20 61 6e 64 20 6c 6f 6e 67 20 61 67 6f 2c 20 79 65 74 20 68 61 72 64 20 61 6e 64 20 63 6c 65 61 72 2e 20 54 68 65 6e 20 74 68 65 20 73 74 61 72 73 0a 67 6f 20 69 6e 20 61 6e 64 20 6f 75 74 2c 20 63 75 74 20 6f 66 66 20 62 79 20 74 68 69 6e 67 73 20 77 69 74 68 20 77 69 6e 67 73 2c 20 6e 69 6e 65 20 6f 66 20 74 68 65 6d 2e 0a 4f 6e 65 20 66 6c 69 65 73 20 73 74 72 61 69 67 68 74 20 74 6f 77 61 72 64 20 79 6f 75 2c 20 67 65 74 74 69 6e 67 20 62 69 67 67 65 72 20 61 6e 64 20 62 69 67 67 65 72 2e 2e 2e 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "A dark sky, tall battlements, and tiny stars, seeming very\nfar away and long ago, yet hard and clear. Then the stars\ngo in and out, cut off by things with wings, nine of them.\nOne flies straight toward you, getting bigger and bigger....",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 38,
    "length": 57,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "44 41 49 4e 20 61 63 63 65 70 74 73 20 79 6f 75 72 20 67 69 66 74 20 61 6e 64 20 73 77 65 61 72 73 20 73 75 70 70 6f 72 74 20 74 6f 20 79 6f 75 72 20 63 61 75 73 65 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "DAIN accepts your gift and swears support to your cause.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 39,
    "length": 46,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "55 73 65 20 74 68 65 20 72 69 6e 67 20 61 74 20 45 72 65 62 6f 72 20 74 6f 20 73 65 63 75 72 65 20 44 61 69 6e 27 73 20 68 65 6c 70 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Use the ring at Erebor to secure Dain's help.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 40,
    "length": 188,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 48 45 4f 44 45 4e 27 73 20 68 61 6e 64 20 74 72 65 6d 62 6c 65 73 20 61 73 20 68 65 20 68 6f 6c 64 73 20 74 68 65 20 62 6c 61 63 6b 20 66 65 61 74 68 65 72 65 64 20 73 68 61 66 74 2e 0a 22 54 68 65 20 52 65 64 20 41 72 72 6f 77 21 20 48 61 73 20 69 74 20 69 6e 64 65 65 64 20 63 6f 6d 65 20 74 6f 20 74 68 61 74 3f 20 49 6e 20 74 68 69 73 20 68 6f 75 72 20 74 68 65 0a 4b 69 6e 67 20 6f 66 20 74 68 65 20 4d 61 72 6b 20 68 69 6d 73 65 6c 66 20 77 69 6c 6c 20 63 6f 6d 65 20 64 6f 77 6e 20 74 6f 20 74 68 65 20 6c 61 6e 64 20 6f 66 20 47 6f 6e 64 6f 72 2e 22 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "THEODEN's hand trembles as he holds the black feathered shaft.\n\"The Red Arrow! Has it indeed come to that? In this hour the\nKing of the Mark himself will come down to the land of Gondor.\"",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 41,
    "length": 46,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 41 72 72 6f 77 20 69 73 20 61 20 74 6f 6b 65 6e 20 6f 66 20 77 61 72 20 74 6f 20 77 68 6f 20 77 69 6c 6c 20 6f 62 65 79 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Arrow is a token of war to who will obey.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 42,
    "length": 220,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "47 61 7a 69 6e 67 20 75 70 6f 6e 20 74 68 65 20 73 63 65 70 74 72 65 2c 20 44 45 4e 45 54 48 4f 52 20 73 70 6f 6b 65 2e 0a 22 46 72 6f 6d 20 74 68 65 20 6e 6f 72 74 68 20 63 6f 6d 65 73 20 6f 6e 65 20 77 68 6f 20 63 6c 61 69 6d 73 20 74 6f 20 62 65 20 49 73 69 6c 64 75 72 27 73 20 68 65 69 72 0a 63 61 72 72 79 69 6e 67 20 74 68 65 20 53 77 6f 72 64 20 6f 66 20 45 6c 65 6e 64 69 6c 2e 20 48 6d 6d 2e 20 41 6e 64 20 6e 6f 77 20 61 20 73 79 6d 62 6f 6c 20 6f 66 20 74 68 65 0a 61 6e 63 69 65 6e 74 20 6b 69 6e 67 73 20 72 65 74 75 72 6e 69 6e 67 2e 20 53 74 72 61 6e 67 65 20 6f 6d 65 6e 73 20 69 6e 20 74 68 65 73 65 20 64 61 72 6b 20 74 69 6d 65 73 2e 22 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Gazing upon the sceptre, DENETHOR spoke.\n\"From the north comes one who claims to be Isildur's heir\ncarrying the Sword of Elendil. Hmm. And now a symbol of the\nancient kings returning. Strange omens in these dark times.\"",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 43,
    "length": 54,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 53 63 65 70 74 72 65 20 77 61 73 20 74 68 65 20 63 68 69 65 66 20 6d 61 72 6b 20 6f 66 20 72 6f 79 61 6c 74 79 20 69 6e 20 4e 75 6d 65 6e 6f 72 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Sceptre was the chief mark of royalty in Numenor.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 44,
    "length": 149,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "48 6f 6c 64 69 6e 67 20 74 68 65 20 53 69 6c 76 65 72 20 4f 72 62 2c 20 54 48 52 41 4e 44 55 49 4c 20 73 70 6f 6b 65 2e 0a 22 57 69 74 68 20 74 68 69 73 20 74 68 65 20 61 6e 63 69 65 6e 74 20 70 72 6f 70 68 65 63 79 20 69 73 20 62 65 67 75 6e 2e 20 57 65 20 77 69 6c 6c 20 6c 65 6e 64 0a 61 6c 6c 20 6f 75 72 20 73 74 72 65 6e 67 74 68 20 69 6e 20 77 68 61 74 20 6d 61 79 20 62 65 20 74 68 65 20 66 69 6e 61 6c 20 63 6f 6e 66 6c 69 63 74 2e 22 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "Holding the Silver Orb, THRANDUIL spoke.\n\"With this the ancient prophecy is begun. We will lend\nall our strength in what may be the final conflict.\"",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 45,
    "length": 57,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 4f 72 62 20 77 61 73 20 61 20 67 69 66 74 20 66 72 6f 6d 20 74 68 65 20 56 61 6c 69 6e 6f 72 20 74 6f 20 74 68 65 20 73 79 6c 76 61 6e 20 65 6c 76 65 73 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Orb was a gift from the Valinor to the sylvan elves.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 46,
    "length": 100,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "20 20 20 49 6e 20 74 68 65 20 48 6f 75 73 65 20 6f 66 20 45 6c 72 6f 6e 64 20 69 6e 20 52 69 76 65 6e 64 65 6c 6c 20 77 61 73 20 68 65 6c 64 20 61 0a 67 72 65 61 74 20 63 6f 75 6e 63 69 6c 2c 20 61 74 20 77 68 69 63 68 20 69 74 20 77 61 73 20 64 65 63 69 64 65 64 20 74 6f 20 61 74 74 65 6d 70 74 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "   In the House of Elrond in Rivendell was held a\ngreat council, at which it was decided to attempt",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 47,
    "length": 34,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "74 68 65 20 64 65 73 74 72 75 63 74 69 6f 6e 20 6f 66 20 74 68 65 20 52 69 6e 67 2c 20 61 6e 64 20 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "the destruction of the Ring, and ",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 48,
    "length": 291,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "61 70 70 6f 69 6e 74 65 64 20 74 68 65 20 52 69 6e 67 2d 62 65 61 72 65 72 2e 20 54 68 65 20 43 6f 6d 70 61 6e 69 6f 6e 73 20 6f 66 20 74 68 65 0a 52 69 6e 67 20 77 65 72 65 20 74 68 65 6e 20 63 68 6f 73 65 6e 2c 20 77 68 6f 20 77 65 72 65 20 74 6f 20 61 69 64 20 68 69 6d 20 69 6e 20 68 69 73 0a 71 75 65 73 74 3a 20 74 6f 20 63 6f 6d 65 20 69 66 20 68 65 20 63 6f 75 6c 64 20 74 6f 20 74 68 65 20 4d 6f 75 6e 74 61 69 6e 73 20 6f 66 20 46 69 72 65 0a 69 6e 20 4d 6f 72 64 6f 72 2c 20 74 68 65 20 6c 61 6e 64 20 6f 66 20 74 68 65 20 45 6e 65 6d 79 20 68 69 6d 73 65 6c 66 2c 20 77 68 65 72 65 0a 61 6c 6f 6e 65 20 74 68 65 20 52 69 6e 67 20 63 6f 75 6c 64 20 62 65 20 75 6e 6d 61 64 65 2e 20 46 6f 72 20 6e 65 61 72 6c 79 20 74 77 6f 0a 6d 6f 6e 74 68 73 20 74 68 65 20 66 65 6c 6c 6f 77 73 68 69 70 20 72 65 73 74 73 20 61 6e 64 20 72 65 63 75 70 65 72 61 74 65 73 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "appointed the Ring-bearer. The Companions of the\nRing were then chosen, who were to aid him in his\nquest: to come if he could to the Mountains of Fire\nin Mordor, the land of the Enemy himself, where\nalone the Ring could be unmade. For nearly two\nmonths the fellowship rests and recuperates.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 49,
    "length": 232,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "54 68 65 20 44 61 72 6b 20 4c 6f 72 64 27 73 20 73 65 72 76 61 6e 74 20 68 61 73 20 72 65 61 63 68 65 64 20 42 61 72 61 64 2d 64 75 72 0a 77 69 74 68 20 74 68 65 20 52 69 6e 67 2e 20 54 68 65 20 68 6f 6c 6f 63 61 75 73 74 20 62 65 67 69 6e 73 2e 20 53 75 64 64 65 6e 6c 79 20 74 68 65 0a 65 61 72 74 68 20 67 72 6f 61 6e 73 20 61 6e 64 20 71 75 61 6b 65 73 21 20 52 69 73 69 6e 67 20 73 77 69 66 74 6c 79 20 75 70 2c 20 68 69 67 68 0a 61 62 6f 76 65 20 74 68 65 20 6d 6f 75 6e 74 61 69 6e 73 2c 20 76 61 73 74 20 73 6f 61 72 69 6e 67 20 64 61 72 6b 6e 65 73 73 20 73 70 72 69 6e 67 73 0a 69 6e 74 6f 20 74 68 65 20 73 6b 79 2c 20 66 6c 69 63 6b 65 72 69 6e 67 20 77 69 74 68 20 66 69 72 65 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "The Dark Lord's servant has reached Barad-dur\nwith the Ring. The holocaust begins. Suddenly the\nearth groans and quakes! Rising swiftly up, high\nabove the mountains, vast soaring darkness springs\ninto the sky, flickering with fire.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 50,
    "length": 253,
    "name": "\u0019\u0001^-]\fp",
    "raw_hex": "57 69 74 68 20 74 68 69 73 20 62 61 74 74 6c 65 2c 20 53 61 75 72 6f 6e 27 73 20 76 69 63 74 6f 72 79 20 69 73 20 61 73 73 75 72 65 64 2e 0a 41 73 20 68 69 73 20 6f 72 63 20 68 6f 72 64 65 73 20 73 70 72 65 61 64 20 64 65 61 74 68 20 61 6e 64 20 64 65 73 74 72 75 63 74 69 6f 6e 0a 74 68 72 6f 75 67 68 6f 75 74 20 74 68 65 20 57 65 73 74 2c 20 53 61 75 72 6f 6e 20 74 75 72 6e 73 20 68 69 73 20 62 61 6c 65 66 75 6c 0a 67 61 7a 65 20 77 69 74 68 69 6e 20 68 69 73 20 72 65 61 6c 6d 2e 20 45 6c 75 73 69 76 65 20 74 68 6f 75 67 68 20 68 65 20 6d 61 79 20 62 65 2c 0a 77 69 74 68 69 6e 20 68 6f 75 72 73 20 74 68 65 20 52 69 6e 67 62 65 61 72 65 72 20 69 73 20 63 61 75 67 68 74 20 69 6e 20 74 68 65 0a 44 61 72 6b 20 4c 6f 72 64 27 73 20 67 72 61 73 70 2e 00",
    "source_file": "BScene.res",
    "source_member": "WarInMiddleEarth/data/Disk.2",
    "text": "With this battle, Sauron's victory is assured.\nAs his orc hordes spread death and destruction\nthroughout the West, Sauron turns his baleful\ngaze within his realm. Elusive though he may be,\nwithin hours the Ringbearer is caught in the\nDark Lord's grasp.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk2",
    "id": 51,
    "length": 301,
    "name": "\u0019\u0001^-]\fp",
