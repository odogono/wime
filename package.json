{
  "name": "wime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "bun tools/commits/changelog.ts",
    "changelog:release": "bun tools/commits/changelog.ts release",
    "findings": "bun tools/findings/findings.ts build build/findings.md",
    "findings:check": "bun tools/findings/findings.ts check",
    "extract-graphics": "bun tools/extract-graphics.ts",
    "extract-text": "bun tools/extract-text.ts",
    "extract-starting-state": "bun tools/extract-starting-state.ts",
    "render-campaign-map": "bun tools/render-campaign-map.ts",
    "export:web": "bun tools/export-web.ts",
    "typecheck": "tsc --noEmit && bun run --cwd web typecheck",
    "test": "bun test tools && bun run --cwd web test",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run findings:check"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@types/bun": "^1.3.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
