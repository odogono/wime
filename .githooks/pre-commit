#!/bin/sh
# Checks the staged files that can go wrong between edits: Findings and
# TypeScript. `bun install` turns this on through core.hooksPath.
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -q '^docs/findings/'; then
  bun tools/findings/findings.ts check || exit 1
fi

ts=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx)$')
if [ -n "$ts" ]; then
  # shellcheck disable=SC2086
  bunx eslint --cache $ts || {
    echo 'pre-commit: fix the lint errors above (`bun run lint:fix` autofixes most).' >&2
    exit 1
  }
fi
