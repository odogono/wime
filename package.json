{
  "name": "wime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "bun tools/commits/changelog.ts",
    "changelog:release": "bun tools/commits/changelog.ts release",
    "findings": "bun tools/findings/findings.ts build build/findings.md",
    "findings:check": "bun tools/findings/findings.ts check",
    "extract-graphics": "bun tools/extract-graphics.ts",
    "extract-text": "bun tools/extract-text.ts",
    "render-campaign-map": "bun tools/render-campaign-map.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tools",
    "check": "bun run typecheck && bun run test && bun run findings:check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
