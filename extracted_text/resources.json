[
  {
    "disk": "disk1",
    "id": 57,
    "length": 226,
    "name": "\u0019\u0001<&]\fp",
    "raw_hex": "54 68 72 65 65 20 52 69 6e 67 73 20 66 6f 72 20 74 68 65 20 45 6c 76 65 6e 2d 6b 69 6e 67 73 20 75 6e 64 65 72 20 74 68 65 20 73 6b 79 2c 0a 20 20 20 53 65 76 65 6e 20 66 6f 72 20 74 68 65 20 44 77 61 72 66 2d 6c 6f 72 64 73 20 69 6e 20 74 68 65 69 72 20 68 61 6c 6c 73 20 6f 66 20 73 74 6f 6e 65 2c 0a 4e 69 6e 65 20 66 6f 72 20 4d 6f 72 74 61 6c 20 4d 65 6e 20 64 6f 6f 6d 65 64 20 74 6f 20 64 69 65 2c 0a 20 20 20 4f 6e 65 20 66 6f 72 20 74 68 65 20 44 61 72 6b 20 4c 6f 72 64 20 6f 6e 20 68 69 73 20 64 61 72 6b 20 74 68 72 6f 6e 65 0a 49 6e 20 74 68 65 20 4c 61 6e 64 20 6f 66 20 4d 6f 72 64 6f 72 20 77 68 65 72 65 20 74 68 65 20 53 68 61 64 6f 77 73 20 6c 69 65 2e 0a 00",
    "source_file": "AText.res",
    "source_member": "WarInMiddleEarth/data/Disk.1",
    "text": "Three Rings for the Elven-kings under the sky,\n   Seven for the Dwarf-lords in their halls of stone,\nNine for Mortal Men doomed to die,\n   One for the Dark Lord on his dark throne\nIn the Land of Mordor where the Shadows lie.\n",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk1",
    "id": 58,
    "length": 158,
    "name": "\u0019\u0001<&]\fp",
    "raw_hex": "20 20 20 4f 6e 65 20 52 69 6e 67 20 74 6f 20 72 75 6c 65 20 74 68 65 6d 20 61 6c 6c 2c 20 4f 6e 65 20 52 69 6e 67 20 74 6f 20 66 69 6e 64 20 74 68 65 6d 2c 0a 20 20 20 4f 6e 65 20 52 69 6e 67 20 74 6f 20 62 72 69 6e 67 20 74 68 65 6d 20 61 6c 6c 20 61 6e 64 20 69 6e 20 74 68 65 20 64 61 72 6b 6e 65 73 73 20 62 69 6e 64 20 74 68 65 6d 0a 49 6e 20 74 68 65 20 4c 61 6e 64 20 6f 66 20 4d 6f 72 64 6f 72 20 77 68 65 72 65 20 74 68 65 20 53 68 61 64 6f 77 73 20 6c 69 65 2e 00",
    "source_file": "AText.res",
    "source_member": "WarInMiddleEarth/data/Disk.1",
    "text": "   One Ring to rule them all, One Ring to find them,\n   One Ring to bring them all and in the darkness bind them\nIn the Land of Mordor where the Shadows lie.",
    "type": "CSTR",
    "warnings": []
  },
  {
    "disk": "disk1",
    "id": 59,
    "length": 332,
    "name": "\u0019\u0001<&]\fp",
    "raw_hex": "50 72 6f 64 75 63 65 64 20 62 79 0a 0a 44 69 72 65 63 74 65 64 20 62 79 0a 0a 47 61 6d 65 20 44 65 73 69 67 6e 0a 0a 0a 50 72 6f 67 72 61 6d 6d 65 64 20 62 79 0a 0a 50 72 6f 64 75 63 74 69 6f 6e 20 41 73 73 69 73 74 61 6e 63 65 0a 0a 50 72 6f 67 72 61 6d 6d 69 6e 67 20 53 75 70 70 6f 72 74 0a 0a 0a 0a 0a 0a 47 72 61 70 68 69 63 20 41 72 74 69 73 74 73 0a 0a 0a 0a 4f 72 69 67 69 6e 61 6c 20 4d 75 73 69 63 20 53 63 6f 72 65 0a 0a 54 65 73 74 20 53 74 61 66 66 0a 0a 0a 0a 0a 44 6f 63 75 6d 65 6e 74 61 74 69 6f 6e 0a 0a 53 6f 6e 69 78 20 4d 75 73 69 63 20 50 6c 61 79 65 72 0a 0a 47 61 6d 65 20 43 6f 6e 63 65 70 74 0a 0a 20 20 43 68 61 72 61 63 74 65 72 73 2c 20 6c 6f 63 61 74 69 6f 6e 73 2c 20 61 6e 64 20 65 76 65 6e 74 73 20 75 73 65 64 0a 20 20 20 20 20 62 79 20 70 65 72 6d 69 73 73 69 6f 6e 20 6f 66 20 74 68 65 20 54 6f 6c 6b 69 65 6e 20 65 73 74 61 74 65 2e 0a 0a 20 20 20 20 20 43 6f 70 79 72 69 67 68 74 20 28 63 29 20 31 39 38 38 20 4d 65 6c 62 6f 75 72 6e 65 20 48 6f 75 73 65 00",
